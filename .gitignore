# Weissman Custom
.*
__*
!.gitignore

# Original MiniLua Git Ignore

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
MANIFEST

# ── Virtual environments ───────────────────────────────────────────────────────
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ── Testing ────────────────────────────────────────────────────────────────────
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover
htmlcov/
.hypothesis/
nosetests.xml
test-results/

# ── Type checking ──────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# ── Build / packaging ─────────────────────────────────────────────────────────
*.spec
pip-wheel-metadata/
share/python-wheels/
*.whl

# ── IDE / editors ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Project-specific ──────────────────────────────────────────────────────────
# Minified output files (generated, not committed)
*.min.lua

# Local test scripts
scratch.lua
test_local.lua
